{
  "uid": "infrapulse-overview",
  "title": "InfraPulse - Infrastructure Overview",
  "description": "Infrastructure monitoring and observability dashboard",
  "tags": ["infrapulse", "infrastructure", "monitoring"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "System Status",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 5},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"infrapulse\"}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "OFFLINE", "color": "red"},
                "1": {"text": "ONLINE", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "title": "Registered Devices",
      "type": "stat",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 5},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "infrapulse_devices_total",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "title": "Registered Services",
      "type": "stat",
      "gridPos": {"x": 12, "y": 0, "w": 6, "h": 5},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "infrapulse_services_total",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "title": "Open Incidents",
      "type": "stat",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "sum(infrapulse_open_incidents)",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "title": "Monitoring Checks per Minute",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 9},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (protocol) (rate(infrapulse_checks_total[5m])) * 60",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Average Check Duration",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 9},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "1000 * sum by (protocol) (rate(infrapulse_check_duration_seconds_sum[5m])) / sum by (protocol) (rate(infrapulse_check_duration_seconds_count[5m]))",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Application Availability History",
      "type": "state-timeline",
      "gridPos": {"x": 0, "y": 14, "w": 24, "h": 5},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "up{job=\"infrapulse\"}",
          "legendFormat": "InfraPulse",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {"text": "DOWN", "color": "red"},
                "1": {"text": "UP", "color": "green"}
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "P95 Check Duration",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 19, "w": 12, "h": 9},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le, protocol) (rate(infrapulse_check_duration_seconds_bucket[5m])))",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        }
      }
    },
    {
      "id": 9,
      "title": "P99 Check Duration",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 19, "w": 12, "h": 9},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.99, sum by (le, protocol) (rate(infrapulse_check_duration_seconds_bucket[5m])))",
          "legendFormat": "{{protocol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        }
      }
    },
    {
      "id": 10,
      "title": "Open Incidents by Type",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 28, "w": 12, "h": 8},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "infrapulse_open_incidents",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "min": 0
        }
      }
    },
    {
      "id": 11,
      "title": "Monitoring Scheduler Cycles",
      "type": "timeseries",
      "gridPos": {"x": 12, "y": 28, "w": 12, "h": 8},
      "datasource": {
        "type": "prometheus",
        "uid": "infrapulse-prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (increase(infrapulse_monitoring_cycles_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0
        }
      }
    }
  ]
}