DB_PORT=5432
DB_NAME=infrapulse
DB_USER=infrapulse
MONITORING_ENABLED=false
MONITORING_INTERVAL=60
MONITORING_WORKERS=4
INCIDENT_FAILURE_THRESHOLD=3
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SERVICE_INCIDENT_FAILURE_THRESHOLD=3
